NUXT_BFF_BASE=http://localhost:4000


NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Shared secret for bff-ts's POST /filters/sync (X-Filters-Sync-Secret header). Server-only,
# not NUXT_PUBLIC_* — see .env's own comment.
FILTERS_SYNC_SECRET=
# 業務中台的 Nitro 共用金鑰（等於業務中台的 NITRO_SHARED_SECRET；伺服器專用，不要放進 public）
NUXT_BFF_NITRO_KEY=

# 無障礙標章（核發後貼官方值，空值時頁尾不渲染）
NUXT_PUBLIC_A11Y_MARK_URL=
NUXT_PUBLIC_A11Y_MARK_IMG=

# check-a11y-pages.mjs 的登入檢查用測試帳號（專用帳號，不是本人帳號）
A11Y_TEST_EMAIL=
A11Y_TEST_PASSWORD=
