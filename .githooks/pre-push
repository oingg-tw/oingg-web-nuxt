#!/bin/sh
# 推送前在本機跑一次 CI 的快速部分（2026-10-14，使用者核准；生態系的共同做法，不用 husky、不加套件）。
# 只是讓錯誤早一點被抓到，不是關卡：GitHub 網頁上的合併、Dependabot 自動合併、git push --no-verify 都不經過這裡——
# 合併的關卡是 GitHub CI（.github/workflows/ci.yml）。建置與開機測試只在 CI 跑（太慢，不放在每次推送）。
# 啟用：pnpm install 的 prepare 會設 git config core.hooksPath .githooks。
set -e
echo "pre-push: typecheck／lint／selfcheck"
pnpm exec nuxt typecheck
pnpm lint
pnpm selfcheck > /dev/null
# 指標文案的 pin（check-metric-copy-drift.mjs）要連業務中台的型錄才對得出來，所以不在 selfcheck 裡。2026-11-27 發現它沒有任何地方會跑：
# 34 支文案的公式版本漂了兩週、三頁頁名跟型錄不一致。本機業務中台開著就順便跑；對不上只印出來、不擋推送（上游升版跟這次推的東西無關）
if curl -sf -m 5 -o /dev/null "${API_BASE:-http://localhost:5400}/metrics"; then
  drift=$(node scripts/check-metric-copy-drift.mjs 2>&1) || { echo "pre-push: 指標文案跟型錄對不上，要重讀文案（不擋推送）："; echo "$drift" | grep -v '^      '; }
fi
echo "pre-push: ok"
